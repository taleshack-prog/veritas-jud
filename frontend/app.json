{
  "expo": {
    "name": "Veritas",
    "slug": "veritas-consumer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F0F4FF"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.veritas.consumer",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "O Veritas usa o microfone para você descrever seu problema por áudio."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F0F4FF"
      },
      "package": "com.veritas.consumer",
      "permissions": ["RECORD_AUDIO"]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "Veritas — Defesa do Consumidor",
      "shortName": "Veritas",
      "description": "App de defesa do consumidor brasileiro com IA",
      "themeColor": "#1B4FE8",
      "backgroundColor": "#F0F4FF"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "eas": {
        "projectId": "SEU_PROJECT_ID_EAS_AQUI"
      }
    }
  }
}
