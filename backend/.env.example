# =============================================
# VERITAS BACKEND — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# NUNCA comite o arquivo .env no git
# =============================================

# Servidor
PORT=3000
NODE_ENV=development

# JWT — Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=TROQUE_POR_UM_SECRET_FORTE_E_ALEATORIO
JWT_EXPIRES_IN=7d

# OpenAI
OPENAI_API_KEY=sk-COLOQUE_SUA_CHAVE_AQUI

# Database (SQLite)
DB_PATH=./database/veritas.db

# Consumidor.gov.br (RPA config)
CONSUMIDOR_BASE_URL=https://www.consumidor.gov.br
RPA_HEADLESS=true

# CORS — domínios permitidos (separados por vírgula)
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logs
LOG_LEVEL=info
LOG_FILE=./logs/veritas.log
